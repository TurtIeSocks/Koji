# client
yarn-debug.log*
yarn-error.log*
node_modules/
.yarn-integrity
dist
.next
logs/*.log

# config
.env
.env.*
docker-compose.yml

# workspace
vrp_tests
debug_files/*
crates/algorithms/src/**/plugins/**/*
