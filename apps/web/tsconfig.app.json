{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    // "@api" stays pointed at index.live.ts here even though vite.config.ts's
    // alias is mode-aware (demo -> index.demo.ts). This path only drives
    // editor/tsc resolution of `@api` imports across the app, and those all
    // stay written against the live surface; type coverage of index.demo.ts
    // itself comes from api-surface.test.ts importing it directly.
    "paths": {
      "@api": ["./src/api/index.live.ts"],
      "@/*": ["./src/*"],
      // wasm-pack output (crates/koji-wasm/pkg) — the demo bundle imports it as
      // `@koji-wasm` (matching vite.config.ts's alias); this mapping lets tsc
      // resolve the module's generated types. `pkg/` is gitignored, so the
      // second entry is a checked-in stub tsc falls back to when nobody has run
      // `bun run wasm:build` — wasm stays optional for a plain `make build`.
      "@koji-wasm": [
        "../../crates/koji-wasm/pkg/koji_wasm.d.ts",
        "./src/types/koji-wasm.d.ts"
      ],
      "shadmin-core": ["./node_modules/ra-core"],
      "shadmin-core/*": ["./node_modules/ra-core/*"]
    }
  },
  "include": ["src"]
}
